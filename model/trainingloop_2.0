import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, TensorDataset

# Set device
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Hyperparameters
lr = 0.0002
epochs = 1
batch_size = 32
latent_dim = 100  # Input noise vector size

# Instantiate models
generator = Generator(input_size=1).to(device)
discriminator = Discriminator(input_size=1).to(device)

# Loss and Optimizers
criterion = nn.BCELoss()
optimizer_G = optim.Adam(generator.parameters(), lr=lr, betas=(0.5, 0.999))
optimizer_D = optim.Adam(discriminator.parameters(), lr=lr, betas=(0.5, 0.999))

# Create dummy dataset (replace with real data)
real_data = torch.randn(1000, 1, 241793)  # Simulated dataset
dataloader = DataLoader(TensorDataset(real_data), batch_size=batch_size, shuffle=True)

# Training Loop
for epoch in range(epochs):
    for real_samples in dataloader:
        real_samples = real_samples[0].to(device)
        batch_size = real_samples.shape[0]

        # Labels
        real_labels = torch.ones(batch_size, 1).to(device)
        fake_labels = torch.zeros(batch_size, 1).to(device)

        # ---- Train Discriminator ----
        optimizer_D.zero_grad()

        # Discriminator on real samples
        real_pred = discriminator(real_samples)
        real_loss = criterion(real_pred, real_labels)

        # Generate fake samples
        noise = torch.randn(batch_size, 1, latent_dim).to(device)
        fake_samples = generator(noise)

        # Discriminator on fake samples
        fake_pred = discriminator(fake_samples.detach())
        fake_loss = criterion(fake_pred, fake_labels)

        # Total loss and update
        d_loss = real_loss + fake_loss
        d_loss.backward()
        optimizer_D.step()

        # ---- Train Generator ----
        optimizer_G.zero_grad()

        fake_pred = discriminator(fake_samples)
        g_loss = criterion(fake_pred, real_labels)  # Wants to fool Discriminator

        g_loss.backward()
        optimizer_G.step()

    print(f"Epoch [{epoch+1}/{epochs}]  D Loss: {d_loss.item():.4f}  G Loss: {g_loss.item():.4f}")

print("Training complete!")
